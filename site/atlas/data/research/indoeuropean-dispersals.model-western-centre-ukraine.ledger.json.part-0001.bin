a/geography/natural-earth-rivers.source.geojson; smaller reference corridors remain explicitly reconstructed. Variable-width ribbons replace filled compact basin patches, and active channel cores / declared unsuitable patches / open water are excluded from terminal placement. Post-arrival dispersal takes 260 modeled calendar years along the supplied land-checked path; these are display assumptions, not source arrival dates or observed settlements. Path and dates are reconstructed."}},{"id":"POLTAVKA","name":"Local Volga–Ural substrate","coord":[52,52],"initial":5000,"capacity":30000,"start":-2400,"group":"II-1B","color":"#87999a","regionId":"Local Volga–Ural substrate","points":[[55.921799,55.180552],[51.716055,53.227122],[52.928135,51.316403],[56.306924,53.247559],[50.560678,52.967568],[55.570644,53.301248],[51.605009,50.204985],[53.845946,52.397637],[55.004644,51.616166],[49.961557,52.948449],[51.806962,51.472041],[56.112751,54.44184],[51.842394,51.165635],[56.86498,53.179214],[51.869852,52.806411],[56.861127,51.136108],[53.837755,51.705734],[50.887944,53.257046],[53.723775,51.408986],[48.758058,53.020505],[55.923475,53.811534],[56.014972,51.771287],[53.059748,52.539933],[55.668432,51.454181],[52.593549,51.589959],[55.571716,54.911458],[52.570588,51.3107],[56.414758,52.952454],[51.071652,52.94953],[50.981028,50.089484],[54.61336,51.849203],[49.368673,52.937617],[51.38064,51.361573],[49.493078,53.281199],[53.333655,51.696398],[51.408034,53.271338],[53.32434,51.378868],[56.197317,53.4347],[50.261069,53.043029],[51.394602,50.296634],[53.558884,52.473426],[50.455086,53.233185],[52.194691,51.585093],[52.019964,51.265934],[56.321461,53.069277],[51.579712,52.919982],[56.237023,52.728941],[56.512487,53.859682],[49.080976,53.059705],[51.060936,51.067347],[51.419463,50.787963],[56.22371,51.637279],[52.758204,52.592421],[56.096735,55.120204],[52.875605,51.313007],[56.281086,53.165754],[50.724179,52.834687],[50.909795,50.121277],[55.687919,53.153423],[54.910377,51.972329],[53