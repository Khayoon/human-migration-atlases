erved settlements. Path and dates are reconstructed.","sources":[],"footprint":{"kind":"polygon","rings":[[[15.253169,43.319568],[19.235199,43.319568],[19.235199,46.178165],[15.253169,46.178165],[15.253169,43.319568]]]},"dispersion":{"years":260,"entryPoints":[[16.26356,43.871906],[16.315324,43.933277],[16.306209,43.831998],[16.344401,44.04136],[16.354611,43.987206],[16.317902,43.936406],[16.214668,43.939087],[16.338195,44.020602],[16.259636,43.865707],[16.250285,43.893249],[16.259636,43.865707],[16.393655,44.028322],[16.334668,43.956748],[16.22303,43.907028],[16.319529,43.983799],[16.293923,43.936758],[16.358442,43.985596],[16.325103,43.947759],[16.259636,43.865707],[16.317971,43.940333],[16.397437,44.032911],[16.346771,44.003468],[16.277944,43.889128],[16.31202,43.835021],[16.32901,44.002492],[16.264948,43.892388],[16.317353,43.828889],[16.302365,43.954252],[16.200414,43.954039],[16.259636,43.865707],[16.329083,43.954548],[16.2918,43.929125],[16.389859,44.032297],[16.265473,43.861313],[16.259636,43.865707],[16.362265,43.990234],[16.234315,43.897782],[16.298303,43.941947],[16.362911,43.991018],[16.286863,43.89259],[16.273645,43.884959],[16.259636,43.865707],[16.23949,43.892777],[16.31961,43.975652],[16.319754,43.942613],[16.342904,44.029887],[16.374157,44.012209],[16.372377,44.002504],[16.318975,43.937707],[16.209151,43.930079],[16.380253,44.020009],[16.288481,43.92548],[16.259636,43.865707],[16.335892,43.958234],[16.32735,44.006026],[16.333712,43.96047],[16.315947,43.934033],[16.315782,43.941884],[16.281323,43.845377],[16.165051,43.965832],[16.323865,43.992348],[16.319514,43.938362],[16.268593,43.893719],[16.352786,43.978732],[16.248556,43.854179],[16.305809,43.956746],[16.259636,43.865707],[16.333394,43.960062],[16.344753,44.028098],[16.351804,43.979026],[16.272084,43.855665],[16.336942,43.964602],[16.277984,43.887969],[16.366334,43.995172],[16.294011,43.936941],[16.330154,43.951271],[16.315232,43.975325],[16.259636,43.865707],[16.313942,43.931601],[16.233487,43.