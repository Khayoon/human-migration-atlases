 geometries are retained under data/geography/natural-earth-rivers.source.geojson; smaller reference corridors remain explicitly reconstructed. Variable-width ribbons replace filled compact basin patches, and active channel cores / declared unsuitable patches / open water are excluded from terminal placement. Post-arrival dispersal takes 280 modeled calendar years along the supplied land-checked path; these are display assumptions, not source arrival dates or observed settlements. Path and dates are reconstructed."}},{"id":"BALKAN-LOCAL","name":"Local Balkan receptor","coord":[20,42],"initial":90000,"capacity":230000,"start":-3000,"group":"ALB-1","color":"#87999a","regionId":"Local Balkan receptor","points":[[21.650095,43.334455],[21.168176,42.378334],[21.087535,44.042748],[20.472858,42.135726],[20.018299,42.069499],[20.28363,41.683365],[19.479739,41.963411],[20.160633,41.847338],[20.418687,42.246964],[20.08163,42.337768],[19.750212,41.986234],[20.015349,41.409411],[20.467113,41.327244],[20.156947,42.067788],[20.293029,41.924709],[19.647244,42.153935],[21.569138,43.437742],[20.677886,41.44398],[21.34555,42.489823],[22.069755,43.145156],[19.924118,42.044187],[21.482435,43.867861],[20.538615,41.156388],[20.126118,42.008712],[21.591336,42.317068],[20.519452,42.018632],[20.011327,42.139917],[20.227241,41.804486],[21.586638,43.692355],[21.467166,43.498092],[20.136659,41.766461],[20.419909,42.327517],[20.212884,42.363565],[19.783545,41.940317],[20.046606,41.486028],[22.20117,42.723467],[20.458641,41.833735],[20.228692,42.074216],[21.612364,42.41648],[21.249476,42.405679],[20.496006,42.203194],[21.948435,42.892726],[20.007742,42.095616],[20.353318,42.207353],[19.83155,41.955146],[19.965029,41.373674],[20.443969,41.375788],[21.167429,43.956786],[20.469376,41.945728],[21.904802,42.749593],[20.085118,42.067942],[20.289285,41.875379],[20.102655,41.684903],[20.27523,42.271382],[21.899098,43.007735],[19.857317,42.021563],[20.53552,41.206393],[22.208157,42.637887],[20.188128,42.0