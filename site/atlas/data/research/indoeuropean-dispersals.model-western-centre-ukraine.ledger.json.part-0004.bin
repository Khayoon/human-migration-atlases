d.","sources":[],"footprint":{"kind":"polygon","rings":[[[-0.85794,44.515743],[6.206266,44.515743],[6.206266,49.653907],[-0.85794,49.653907],[-0.85794,44.515743]]]},"dispersion":{"years":300,"entryPoints":[[4.048319,46.105989],[4.010062,45.912836],[4.017945,45.928842],[4.035768,45.98469],[3.900734,46.012491],[4.022193,46.098195],[3.982391,45.916811],[4.051555,46.113715],[3.915231,46.004873],[4.230976,45.898828],[3.997214,45.951919],[3.849663,46.093979],[3.996635,46.006717],[4.005647,45.988323],[4.032096,45.923626],[3.984261,45.962428],[3.930099,45.985537],[3.912996,46.029102],[4.040282,46.086799],[4.035173,45.920605],[4.094975,46.035016],[4.022169,46.098112],[4.140766,45.880256],[4.033897,46.071551],[3.93619,46.017428],[4.054142,46.119892],[4.015585,45.941184],[4.107166,45.91733],[4.004748,46.035755],[3.980872,45.91783],[4.045278,46.098728],[4.003488,45.957252],[4.087863,45.913037],[4.019403,46.036943],[3.892669,46.030949],[4.014052,46.069056],[3.941073,46.007315],[3.95751,45.957994],[4.007958,46.009616],[4.035842,45.926533],[4.016749,45.968524],[3.856888,46.084869],[3.980481,45.90788],[4.026129,45.916037],[3.930868,45.986801],[4.204942,45.902446],[3.976376,45.934206],[3.998676,46.021359],[4.00345,45.957713],[4.028131,45.927528],[3.929051,45.9889],[3.999273,46.016161],[3.971692,45.941217],[3.94881,45.973101],[4.005543,46.003851],[4.07998,46.02227],[3.955564,45.960448],[3.98868,45.978244],[4.006035,45.92796],[4.042681,46.092526],[3.98689,45.971838],[4.005571,46.003916],[4.007353,45.920144],[4.080161,45.920814],[4.031553,45.992682],[4.002833,46.028903],[4.00754,45.922826],[3.842967,46.08839],[4.113275,45.915183],[3.976376,45.934206],[3.90858,46.019691],[3.983798,45.960773],[3.992378,45.972414],[4.020761,46.093071],[3.968859,45.992713],[3.882723,46.079312],[3.998973,45.897996],[4.078573,45.921019],[3.840803,46.105151],[4.018354,46.084455],[3.992121,45.833232],[4.015428,46.027453],[4.205067,45.902428],[3.998296,45.952838],[3.991779,45.938086],[3.875011,46.054121],[3.984