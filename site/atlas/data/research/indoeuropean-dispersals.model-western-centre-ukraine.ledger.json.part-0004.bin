es are reconstructed.","sources":[],"footprint":{"kind":"polygon","rings":[[[-0.899524,44.418751],[6.257901,44.418751],[6.257901,49.720449],[-0.899524,49.720449],[-0.899524,44.418751]]]},"dispersion":{"years":300,"entryPoints":[[4.037925,46.081169],[3.991468,45.923028],[3.990368,45.946099],[3.934535,45.984245],[4.003697,46.031995],[3.989099,45.897416],[4.003743,45.999552],[4.109024,45.915774],[3.976376,45.934206],[3.99242,45.994527],[3.832045,46.101013],[4.000267,46.019718],[3.960713,45.951208],[3.900826,46.047324],[4.010719,46.016209],[4.03308,45.921165],[3.976376,45.934206],[3.849894,46.093688],[4.007443,46.045404],[3.979931,45.911407],[4.027004,45.921808],[4.008024,46.009775],[3.842449,46.088989],[4.006658,46.042593],[3.967958,45.951639],[3.985913,45.936264],[4.015428,45.929167],[4.041455,46.060834],[4.006699,46.042741],[3.994079,45.927741],[3.986443,45.958243],[3.883097,46.042011],[3.976376,45.934206],[3.911648,46.015822],[3.981278,46.016832],[3.99678,45.982927],[3.944867,45.999459],[3.924642,45.999438],[4.041203,46.088998],[4.015208,45.859071],[3.976376,45.934206],[4.024567,45.975169],[4.021068,46.09417],[3.992893,45.928174],[4.226289,45.89948],[3.976376,45.934206],[4.014909,46.084801],[3.994314,45.955405],[4.100465,45.918194],[3.873885,46.052658],[4.020828,46.09331],[3.957132,45.951738],[3.949971,45.971463],[3.985394,45.919755],[4.083213,46.025019],[3.950611,45.966694],[3.990351,45.984226],[3.977146,45.947179],[4.13523,45.900436],[3.996255,45.981673],[3.903038,46.018965],[3.994877,46.000425],[3.936575,46.016629],[4.022264,46.043777],[3.998161,45.923666],[4.075623,45.9214],[4.032331,45.993507],[3.988876,45.978948],[3.976673,45.927422],[3.993634,45.927904],[3.988803,45.963879],[3.942527,45.973326],[3.976376,45.934206],[3.976376,45.934206],[3.897243,46.033985],[3.994217,45.976806],[3.928138,45.989956],[4.015408,46.073912],[3.973347,45.942025],[3.877495,46.090501],[3.996753,45.982861],[3.976376,45.934206],[3.976376,45.934206],[3.902622,46.027202],[4.019611,46.0889