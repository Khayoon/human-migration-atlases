h-rivers.source.geojson; smaller reference corridors remain explicitly reconstructed. Variable-width ribbons replace filled compact basin patches, and active channel cores / declared unsuitable patches / open water are excluded from terminal placement. Post-arrival dispersal takes 300 modeled calendar years along the supplied land-checked path; these are display assumptions, not source arrival dates or observed settlements. Path and dates are reconstructed."}},"NORWAY-LOCAL":{"points":[[11.056448,61.257638],[11.557228,61.12763],[10.841776,62.104442],[9.521177,61.233272],[10.791203,61.354707],[11.070716,61.854811],[9.953432,61.09116],[11.496211,61.27536],[11.111596,61.196886],[9.25088,61.319363],[10.244856,60.858151],[9.745531,60.839164],[9.713537,61.195445],[10.618004,61.894069],[11.857663,60.820274],[10.995433,61.310503],[11.000176,61.779785],[10.054341,60.98253],[11.146717,62.639022],[10.490868,62.049202],[11.084867,61.913829],[11.458829,61.33199],[10.681186,61.874587],[11.94775,60.735014],[9.154221,61.356218],[10.173883,60.906247],[11.040727,62.56557],[10.600018,61.966161],[10.439419,60.690788],[10.873775,61.339575],[8.945521,61.479052],[10.022624,60.698919],[10.094563,61.067112],[10.631111,61.758603],[11.252425,62.67758],[12.087335,60.678348],[11.106715,61.158596],[11.116045,61.594199],[11.381448,62.451572],[8.658873,61.55556],[10.911799,62.489839],[11.375741,61.402828],[10.686656,61.934347],[11.889413,60.787081],[11.001832,61.265513],[9.109324,61.423935],[10.130532,60.618588],[10.098233,60.952806],[10.810307,62.121614],[9.479246,61.244322],[10.705761,61.408342],[8.828833,61.503981],[9.890611,61.089459],[11.444906,61.292609],[10.632839,61.841397],[11.257477,62.747738],[12.019136,60.711195],[11.047744,61.212881],[11.616861,60.60132],[10.98301,62.54034],[9.75936,60.871204],[11.284172,60.977677],[10.612039,61.922004],[11.83218,60.839415],[10.905343,61.30448],[8.964086,61.431823],[10.043605,60.661426],[10.031448,61.002293],[11.562751,61.20779],[10.812915,62.148203],